generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries    Enquiry[]
  appointments Appointment[]
  subscriber   Subscriber?
  history      CustomerNote[]

  @@index([email])
  @@index([phone])
  @@index([name])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String   @default("note")
  body       String
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Enquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("new")
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Appointment {
  id                 String    @id @default(cuid())
  name               String
  email              String
  phone              String
  service            String
  preferredDate      String
  preferredTime      String
  method             String    @default("in-office")
  notes              String?
  adminNotes         String?
  status             String    @default("requested")
  confirmationSentAt DateTime?
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([preferredDate])
  @@index([createdAt])
}

model Subscriber {
  id                   String   @id @default(cuid())
  email                String?
  phone                String?
  emailOptIn           Boolean  @default(false)
  smsOptIn             Boolean  @default(false)
  preferences          String   @default("[]")
  status               String   @default("active")
  mailchimpMemberId    String?
  customerId           String?  @unique
  customer             Customer? @relation(fields: [customerId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
}

model AvailabilityRule {
  id        String  @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  active    Boolean @default(true)

  @@unique([weekday])
  @@index([active])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
