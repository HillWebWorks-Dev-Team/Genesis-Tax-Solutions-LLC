# Supabase Postgres (Prisma)
# DATABASE_URL = Transaction pooler (port 6543)
# DIRECT_URL   = Session / direct (port 5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

ADMIN_SETUP_CODE="0000"
SESSION_SECRET="replace-with-a-long-random-secret"

# Transactional email (appointment confirmations / office alerts)
RESEND_API_KEY=""
EMAIL_FROM="Genesis Tax Solutions <bookings@yourdomain.com>"

# Mailchimp Marketing API
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
